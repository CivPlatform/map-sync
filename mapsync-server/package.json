{
    "name": "mapsync-server",
    "version": "SNAPSHOT",
    "type": "module",
    "private": true,
    "author": "Gjum",
    "license": "GPL-3.0-only",
    "scripts": {
        "build": "tsc",
        "check:types": "tsc --noEmit --checkJs",
        "check:style": "prettier --check .",
        "format": "prettier -w .",
        "test": "true",
        "start": "node --enable-source-maps dist/main.js",
        "start:dev": "tsc && node --inspect --enable-source-maps dist/main.js"
    },
    "dependencies": {
        "async-mutex": "^0.5.0",
        "uuid": "^14.0.1",
        "ws": "^8.21.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.0.0",
        "@types/ws": "^8.18.1",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3"
    },
    "optionalDependencies": {
        "bufferutil": "^4.1.0"
    },
    "engines": {
        "node": "26.x"
    },
    "prettier": {
        "useTabs": false,
        "tabWidth": 4,
        "trailingComma": "all",
        "singleQuote": false,
        "semi": true
    },
    "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
