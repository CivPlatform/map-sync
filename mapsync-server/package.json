{
    "name": "mapsync-server",
    "version": "SNAPSHOT",
    "type": "module",
    "private": true,
    "author": "Gjum",
    "license": "GPL-3.0-only",
    "scripts": {
        "build": "tsc",
        "check:types": "tsc --noEmit --checkJs",
        "check:style": "prettier --check .",
        "format": "prettier -w .",
        "test": "true",
        "start": "node --enable-source-maps dist/main.js",
        "start:dev": "tsc && node --inspect --enable-source-maps dist/main.js"
    },
    "dependencies": {
        "async-mutex": "^0.5.0",
        "uuid": "^14.0.1",
        "ws": "^8.21.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.0.0",
        "@types/ws": "^8.18.1",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3"
    },
    "optionalDependencies": {
        "bufferutil": "^4.1.0"
    },
    "engines": {
        "node": "26.x"
    },
    "prettier": {
        "useTabs": false,
        "tabWidth": 4,
        "trailingComma": "all",
        "singleQuote": false,
        "semi": true
    },
    "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
