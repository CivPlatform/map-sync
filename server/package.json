{
    "name": "civmap-server",
    "version": "SNAPSHOT",
    "private": true,
    "author": "Gjum",
    "license": "GPL-3.0-only",
    "type": "module",
    "module": "src/main.ts",
    "scripts": {
        "check:types": "bunx --bun tsc --noEmit --checkJs",
        "check:style": "bunx --bun prettier --check .",
        "format": "bunx --bun prettier -w .",
        "test": "bun test ./src/*.test.ts",
        "start": "bun src/main.ts",
        "start:dev": "bun --inspect src/main.ts",
        "compile": "bun build --compile . --outfile out/mapsync-server"
    },
    "dependencies": {
        "async-mutex": "^0.4.0",
        "kysely": "^0.28.2",
        "kysely-bun-sqlite": "^0.4.0",
        "zod": "^3.25.57"
    },
    "devDependencies": {
        "@types/bun": "^1.2.15",
        "prettier": "^3.0.1",
        "typescript": "^5.8.3"
    },
    "prettier": {
        "useTabs": false,
        "tabWidth": 4,
        "trailingComma": "all",
        "singleQuote": false,
        "semi": true
    }
}
